FROM hanoi-opensearch-base:ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

COPY api-requirements.txt /tmp/api-requirements.txt
RUN pip install --no-cache-dir \
      torch==2.11.0+cpu \
      --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/api-requirements.txt

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin api
USER 10001:10001
WORKDIR /app/stage1

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "demo_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
