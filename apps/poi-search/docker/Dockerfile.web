# Optional: bake a self-contained web image (slow first time; layer-cached after).
# Day-to-day: use scripts/refresh-web.ps1 instead (host npm build + nginx mount).

FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY web/ ./
RUN rm -f .env .env.local .env.production.local 2>/dev/null || true
ARG VITE_API_BASE_URL=
ARG VITE_GOONG_MAPTILES_KEY=
ARG VITE_MAP_STYLE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOONG_MAPTILES_KEY=$VITE_GOONG_MAPTILES_KEY
ENV VITE_MAP_STYLE_URL=$VITE_MAP_STYLE_URL
ARG VITE_CORPUS_VERSION=vn-poi-core-v3-semantic-address-dedup50
ENV VITE_CORPUS_VERSION=$VITE_CORPUS_VERSION
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
