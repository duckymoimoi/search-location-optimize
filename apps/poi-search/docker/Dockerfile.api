# syntax=docker/dockerfile:1.6
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY api-requirements.txt /tmp/api-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
      torch==2.6.0+cu126 \
      --index-url https://download.pytorch.org/whl/cu126 \
    && pip install -r /tmp/api-requirements.txt

# Warm Hugging Face weights into the image for offline-ish first boot.
ARG POI_MODEL_ID=intfloat/multilingual-e5-small
ENV POI_MODEL_ID=${POI_MODEL_ID}
ENV HF_HOME=/model-cache
RUN --mount=type=cache,target=/root/.cache/huggingface \
    python -c "from transformers import AutoModel, AutoTokenizer; \
 mid='${POI_MODEL_ID}'; AutoTokenizer.from_pretrained(mid); AutoModel.from_pretrained(mid)"

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin api \
    && mkdir -p /model-cache \
    && chown -R 10001:10001 /model-cache
USER 10001:10001
WORKDIR /app/api

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
