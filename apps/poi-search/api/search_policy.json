{
  "policy_version": "search-policy-stable-demo-v9",
  "default_retrieval_profile": "hybrid",
  "retrieval": {
    "branch_depth": 50,
    "candidate_budget": 50,
    "ann_candidates": 200,
    "rrf_constant": 60,
    "dense_min_compact_chars": 5
  },
  "lexical": {
    "exact": 20.0,
    "alias_exact": 16.0,
    "phrase": 10.0,
    "phrase_address": 6.0,
    "cross_or": 5.0,
    "best_or": 2.0,
    "prefix_field": 8.0,
    "leading_prefix": 10.0,
    "code_compact": 14.0,
    "minimum_should_match": 1,
    "fuzzy": 0.0,
    "and_match": 3.0,
    "number_bonus": 1.5
  },
  "warmup_queries": ["ga", "vincom", "phở bò nam định", "23 nguyễn trãi"],
  "query_rewrites": [
    {"pattern": "\\bbv\\b", "replacement": "bệnh viện"},
    {"pattern": "\\bdh\\b", "replacement": "đại học"},
    {"pattern": "\\bthpt\\b", "replacement": "trung học phổ thông"},
    {"pattern": "\\bthcs\\b", "replacement": "trung học cơ sở"}
  ],
  "ranking": {
    "geo_mode": "v6",
    "geo_equivalent_window": 10,
    "geo_min_retrieval_ratio": 0.5,
    "geo_distance_band_m": 500,
    "geo_score_cap": 0.35,
    "retrieval_weight": 0.65,
    "name_token_overlap_weight": 0.35,
    "relevance_blend": 0.65,
    "geo_blend": 0.35,
    "geo_decay_m": 5000,
    "exact_text_bonus": 0.04,
    "protect_exact_name_or_alias": true,
    "name_address_priority": true,
    "name_address_min_query_tokens": 4,
    "name_address_min_evidence": 0.5,
    "name_address_min_addr_span": 2,
    "name_match_quality_priority": true,
    "accent_match_priority": true,
    "deduplication": {
      "entity_group_id": true,
      "normalized_name_within_m": 50
    },
    "nearby_name_rescue": {
      "enabled": true,
      "radius_m": 5000,
      "limit": 15,
      "min_query_chars": 3,
      "fetch_size": 40
    }
  },
  "cors_origins": [
    "http://localhost:5173",
    "http://127.0.0.1:5173",
    "http://localhost:5174",
    "http://127.0.0.1:5174"
  ],
  "notes": [
    "v9 lexical: a pure number beside a letter span is constant_score number_bonus, not a BM25 term. codes_compact requires both a letter and a digit in one token.",
    "v8 lexical: dotted/hyphenated alphanumeric spans are glued before the standard analyzer (s10.2 and s1.02 share s102). Slash is not glued.",
    "v8 geo: equivalent-name cohort orders by cap*exp(-d/5000m). cap 0.35 < 1 match tier, so an exact far hit stays above a nearer partial.",
    "v8: codes_compact keyword (alnum fold) so S2.02 matches s202 without hard-coded building patterns.",
    "v7 lexical = gold iterate winner v4_photonish (docs/deliveries/w1_evidence/12_LEXICAL_ITERATE.md).",
    "MSM=1; cross/best OR + context_text; fuzzy off. Hybrid R@1000 0.999 on gold_stage1_v1."
  ]
}
