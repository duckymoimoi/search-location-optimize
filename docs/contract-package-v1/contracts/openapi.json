    "/v1/sessions": {
      "post": {
        "operationId": "createDemoSession",
        "security": [],
        "description": "Create server-owned anonymous demo session; no client subject accepted. Production mode requires application authentication integration.",
        "responses": {
          "200": {
            "description": "Session created; opaque HttpOnly cookie",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "poi_demo_session; HttpOnly; SameSite=Lax; Secure on HTTPS"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
