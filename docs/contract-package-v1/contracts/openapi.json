  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "poi_demo_session"
      }
    },
    "schemas": {
      "Point": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      },
      "MapPoint": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "quality": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "lat",
          "lon",
          "quality"
        ],
        "additionalProperties": false
      },
      "Origin": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "poi"
              },
              "poi_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "poi_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "gps"
              },
              "point": {
                "$ref": "#/components/schemas/Point"
              },
              "accuracy_m": {
                "type": "number",
                "minimum": 0
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "point",
              "accuracy_m",
              "observed_at"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "map"
              },
              "point": {
                "$ref": "#/components/schemas/Point"
              }
            },
            "required": [
              "kind",
              "point"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "Versions": {
        "type": "object",
        "properties": {
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "corpus_version": {
            "type": "string",
            "minLength": 1
          },
          "index_version": {
            "type": "string",
            "minLength": 1
          },
          "encoder_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "embedding_space_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "passage_builder_version": {
            "type": "string",
            "minLength": 1
          },
          "scope_policy_version": {
            "type": "string",
            "minLength": 1
          },
          "candidate_policy_version": {
            "type": "string",
            "minLength": 1
          },
          "ranker_id": {
            "type": "string",
            "minLength": 1
          },
          "feature_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "release_id",
          "corpus_version",
          "index_version",
          "encoder_id",
          "embedding_space_id",
          "passage_builder_version",
          "scope_policy_version",
          "candidate_policy_version",
          "ranker_id",
          "feature_version"
        ],
        "additionalProperties": false
      },
